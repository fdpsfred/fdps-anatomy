# The Ghidra snapshot is regenerated with LF endings. Without this, a checkout on
# Windows would rewrite it to CRLF and the next export would look like a full-file diff.
ghidra_snapshot/*.txt text eol=lf

# Same for the fdps-data skill's data set: the build writes LF, so a CRLF checkout
# would make every rebuild look like a full rewrite.
.claude/skills/fdps-data/fdps_data.json text eol=lf

# Same for the guide mirror: fetch writes LF, so a CRLF checkout would make every
# re-fetch look like a full rewrite. The images are binary and must not be touched.
docs/guide/**/*.htm text eol=lf
docs/guide/**/*.txt text eol=lf
docs/guide/**/*.jpg binary
docs/guide/**/*.png binary
docs/guide/**/*.gif binary

# Workflow scripts must stay LF: the Workflow tool reads the working copy and
# rejects a script containing CR as "control characters", so with core.autocrlf
# true a plain checkout on Windows produces a script it refuses to run. The
# failure names neither the file nor the line ending, so it costs a while to
# find.
tools/**/*.js text eol=lf

# cut_content/ media: images and sounds regenerated from the game files. Binary,
# so no line-ending conversion or textual diff ever touches them.
cut_content/**/*.png binary
cut_content/**/*.wav binary

# The chapter pages' annotated battlefields, regenerated from the game files by
# tools/chapter_docs/chapter_facts.py render-maps.
chapters/maps/*.png binary

# The ETen font files are raw bitmaps; any line-ending conversion corrupts them.
tools/glyph/ET3_fonts/*.15 binary
